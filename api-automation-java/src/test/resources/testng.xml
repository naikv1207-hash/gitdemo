<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="API Automation Suite" verbose="1" parallel="methods" thread-count="3">

    <listeners>
        <listener class-name="com.api.utils.ExtentReportListener"/>
    </listeners>

    <!-- ✅ All API Tests -->
    <test name="User API Tests">
        <classes>
            <class name="com.api.tests.GetUserTest"/>
            <class name="com.api.tests.CreateUserTest"/>
            <class name="com.api.tests.UpdateUserTest"/>
            <class name="com.api.tests.DeleteUserTest"/>
        </classes>
    </test>

    <test name="Auth API Tests">
        <classes>
            <class name="com.api.tests.AuthTest"/>
        </classes>
    </test>

    <test name="Schema Validation Tests">
        <classes>
            <class name="com.api.tests.SchemaValidationTest"/>
        </classes>
    </test>

</suite>
