{
  "info": {
    "name": "Reqres API - Full Collection",
    "_postman_id": "api-automation-collection-v1",
    "description": "Complete Postman collection for Reqres.in API — covers GET, POST, PUT, PATCH, DELETE, Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://reqres.in/api" },
    { "key": "auth_token", "value": "" },
    { "key": "user_id", "value": "2" }
  ],
  "item": [

    {
      "name": "👥 Users",
      "item": [
        {
          "name": "GET All Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users?page=1",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [{ "key": "page", "value": "1" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has data array', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  pm.expect(json.data.length).to.be.greaterThan(0);",
                  "});",
                  "pm.test('Response time < 3000ms', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET User By ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/{{user_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('User has id, email, first_name', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('id');",
                  "  pm.expect(json.data).to.have.property('email');",
                  "  pm.expect(json.data).to.have.property('first_name');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET User Not Found (404)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/9999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Response body is empty object', () => {",
                  "  pm.expect(pm.response.text()).to.equal('{}');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Create User",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"job\": \"QA Engineer\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response has id and createdAt', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.have.property('createdAt');",
                  "  pm.environment.set('created_user_id', json.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT Update User",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/users/{{user_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"job\": \"Updated Job\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('updatedAt is present', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('updatedAt');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH Partial Update User",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/users/{{user_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job\": \"Lead Automation Engineer\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Job is updated', () => {",
                  "  pm.expect(pm.response.json().job).to.equal('Lead Automation Engineer');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE User",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/users/{{user_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('Body is empty', () => {",
                  "  pm.expect(pm.response.text()).to.equal('');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "POST Login - Success",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"eve.holt@reqres.in\",\n  \"password\": \"cityslicka\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token is present', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('token');",
                  "  pm.collectionVariables.set('auth_token', json.token);",
                  "  console.log('Token saved:', json.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Login - Missing Password (400)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"peter@klaven\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error message is present', () => {",
                  "  pm.expect(pm.response.json().error).to.equal('Missing password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Register - Success",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"eve.holt@reqres.in\",\n  \"password\": \"pistol\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has id and token', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.have.property('token');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
